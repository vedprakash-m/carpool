# E2E Testing Environment Variables
# Copy this file to .env.e2e and fill in the values before running E2E tests
# Run with: docker-compose --env-file .env.e2e -f docker-compose.e2e.yml up

# MongoDB credentials for the test container
E2E_MONGO_USER=testuser
E2E_MONGO_PASS=your-secure-test-password

# MongoDB connection URL (uses credentials above)
E2E_MONGODB_URL=mongodb://${E2E_MONGO_USER}:${E2E_MONGO_PASS}@mongodb-test:27017/carpool_test?authSource=admin

# Storage connection (uses Azurite emulator)
E2E_STORAGE_CONNECTION=UseDevelopmentStorage=true

# JWT secret for test token generation (use any random string)
E2E_JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# NextAuth secret for frontend session management (use any random string)
E2E_NEXTAUTH_SECRET=your-random-nextauth-secret-at-least-32-chars
